# Merge these pilot requirements into the existing deployment after the owner supplies it.
# This file is a template, not credentials and not a runnable production configuration.
AP_SERVICE_MODE=hosted
AP_HOSTED_BILLING_MODE=manual
AP_DB_TYPE=POSTGRES
AP_REDIS_TYPE=STANDALONE
AP_EXECUTION_MODE=SANDBOX_CODE_ONLY
AP_FILE_STORAGE_LOCATION=DB
AP_S3_USE_SIGNED_URLS=false
AP_SANDBOX_PROPAGATED_ENV_VARS=
AP_API_RATE_LIMIT_AUTHN_ENABLED=true
AP_ALLOW_OPEN_SIGN_UP=false
AP_MAX_FILE_SIZE_MB=25
AP_EXECUTION_DATA_RETENTION_DAYS=30
AP_HOSTED_STORAGE_LIMITS_JSON={"trial":67108864,"training":268435456,"assessment":268435456,"starter":1073741824,"team":4294967296,"global":8589934592}
# Supply externally via the existing secret store, never commit values:
# AP_FRONTEND_URL=https://<approved-domain>
# AP_INTERNAL_URL=<private-api-url>
# AP_HOSTED_OPERATOR_IDENTITY_IDS=<approved-21-character-identity-ids>
# AP_ENCRYPTION_KEY=<same durable key as the backed-up database>
# AP_JWT_SECRET=<durable secret; coordinate rotation with session invalidation>
# PostgreSQL, Redis, worker token, ingress, backup and monitoring credentials use existing infrastructure.
# Configure the Sydekyks managed provider in Platform > Managed AI. No customer-visible supplier key.
# Both API and worker must use the identical tested release; never deploy API alone.
