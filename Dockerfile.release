FROM --platform=$BUILDPLATFORM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS build
WORKDIR /usr/src/app
ENV REDISMS_DISABLE_POSTINSTALL=1
RUN architecture="$(uname -m)" && case "$architecture" in x86_64) bun_arch=x64-baseline;; aarch64) bun_arch=aarch64;; *) exit 1;; esac && apt-get update && apt-get install -y --no-install-recommends curl ca-certificates unzip python3 g++ make git && curl -fsSL --retry 3 "https://github.com/oven-sh/bun/releases/download/bun-v1.4.0/bun-linux-${bun_arch}.zip" -o /tmp/bun.zip && unzip /tmp/bun.zip -d /tmp/bun && mv /tmp/bun/bun-*/bun /usr/local/bin/bun && rm -rf /tmp/bun /tmp/bun.zip /var/lib/apt/lists/*
COPY . .
RUN test ! -e packages/ee && test ! -e packages/server/api/src/app/ee
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
RUN npm run check:distribution:build
RUN NODE_OPTIONS=--max-old-space-size=4096 bun x turbo run build --concurrency=2 --filter=web --filter=@activepieces/engine --filter=api --filter=worker
RUN find dist/packages/web -name '*.map' -delete
RUN node scripts/stage-sydekyks-runtime.mjs && cd runtime && bun install --lockfile-only --ignore-scripts && cd .. && node scripts/check-runtime-resolution.mjs && node scripts/audit-distribution-boundaries.mjs runtime --artifact
FROM ibassoftware/sydekyks@sha256:0d07ca0a342b0cd1a0140d05e2e9238daa54d47a179f642240481ac4abd82ec5
WORKDIR /usr/src/app
RUN rm -rf packages dist
COPY --from=build /usr/src/app/runtime/ ./
COPY --from=build /usr/src/app/packages/server/api/src/assets/default.cf /usr/local/etc/isolate
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --production --frozen-lockfile
ARG SYDEKYKS_SOURCE_REVISION
LABEL org.opencontainers.image.version="1.0.6" org.opencontainers.image.revision=$SYDEKYKS_SOURCE_REVISION org.opencontainers.image.base.digest="sha256:0d07ca0a342b0cd1a0140d05e2e9238daa54d47a179f642240481ac4abd82ec5"
RUN node -e "const fs=require('fs');const p='release-manifest.json';const m=JSON.parse(fs.readFileSync(p,'utf8'));m.upstreamRevision='c7d897533048d65e08ee293958bdb42e6d70b28d';m.fullRuntimeRebuild=true;m.baseImageDigest='sha256:0d07ca0a342b0cd1a0140d05e2e9238daa54d47a179f642240481ac4abd82ec5';fs.writeFileSync(p,JSON.stringify(m,null,2))"
